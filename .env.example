# Copy to .env (never commit .env). Shared by both machines.
PLATFORM_HOST=localhost        # Mac IP on the shared network; localhost for the Fedora mock
CONTROL_HOST=localhost         # Fedora IP on the shared network
CS_TOKEN=change-me             # X-CS-Token for /control/* and /admin/*
REDIS_PASSWORD=change-me
LLM_BACKEND=mock               # mock | ollama

# --- web layer ---
JWT_SECRET=change-me-long-random       # student portal JWT signing key (Mac)
GATEWAY_URL=http://localhost:8000      # used by Express on the Mac
STUDENT_URL=http://localhost:8001      # used by Express on the Mac
CORE_URL=http://localhost:8600         # used by the staff portal and status page on Fedora
MYSQL_HOST=localhost                   # Fedora
MYSQL_DB=cascadeshield_web
MYSQL_USER=csweb
MYSQL_PASSWORD=change-me
