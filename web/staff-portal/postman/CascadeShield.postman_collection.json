{
  "info": {
    "name": "CascadeShield Staff Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "instructor@vit.edu",
        "type": "string"
      },
      {
        "key": "password",
        "value": "instructor123",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('startAt', new Date(Date.now() + 30 * 86400000).toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "startAt",
      "value": ""
    },
    {
      "key": "examId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "List courses",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "courses"
          ]
        },
        "header": []
      }
    },
    {
      "name": "Upcoming exams (public)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/exams/upcoming",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exams",
            "upcoming"
          ]
        },
        "header": [],
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Create exam",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('examId', pm.response.json().exam.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/exams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exams"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course\": \"DSA101\",\n  \"start\": \"{{startAt}}\",\n  \"duration_min\": 60,\n  \"expected_students\": 100,\n  \"topics\": [\n    \"bst\",\n    \"heaps\"\n  ]\n}"
        }
      }
    },
    {
      "name": "Create exam without auth is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/exams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exams"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course\": \"DSA101\",\n  \"start\": \"{{startAt}}\",\n  \"duration_min\": 60,\n  \"expected_students\": 100,\n  \"topics\": [\n    \"bst\",\n    \"heaps\"\n  ]\n}"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Create exam with invalid body",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/exams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exams"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course\": \"DSA101\",\n  \"start\": \"{{startAt}}\",\n  \"duration_min\": 1,\n  \"expected_students\": 100,\n  \"topics\": [\n    \"bst\",\n    \"heaps\"\n  ]\n}"
        }
      }
    },
    {
      "name": "List all exams",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/exams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exams"
          ]
        },
        "header": []
      }
    },
    {
      "name": "Update exam",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{baseUrl}}/api/exams/{{examId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exams",
            "{{examId}}"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"course\": \"DSA101\",\n  \"start\": \"{{startAt}}\",\n  \"duration_min\": 60,\n  \"expected_students\": 150,\n  \"topics\": [\n    \"bst\",\n    \"heaps\"\n  ]\n}"
        }
      }
    },
    {
      "name": "Delete exam",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/exams/{{examId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exams",
            "{{examId}}"
          ]
        },
        "header": []
      }
    }
  ]
}
